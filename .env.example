# App
PROJECT_NAME=Centralia Travel API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=change-this-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database (Supabase)
# DATABASE_URL - transaction pooler (6543) - serverning ishlashi uchun (uvicorn)
DATABASE_URL=postgresql://postgres.vhhqyictpsqvkhtytlbx:YOUR-PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL - session pooler (5432) - FAQAT Alembic migratsiyalar uchun
DIRECT_URL=postgresql://postgres.vhhqyictpsqvkhtytlbx:YOUR-PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# CORS - frontend domain(lar)ini shu yerga qo'shing
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://www.centraliatours.com"]

# Payme (https://developer.help.paycom.uz)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_KEY=
PAYME_ACCOUNT_FIELD=booking_id

# Click (https://docs.click.uz)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Stripe (Visa/Mastercard - xalqaro to'lovlar uchun) https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# To'lovdan keyin foydalanuvchi qaytariladigan frontend manzillari
FRONTEND_SUCCESS_URL=https://www.centraliatours.com/booking/success
FRONTEND_CANCEL_URL=https://www.centraliatours.com/booking/cancel

# Media
MEDIA_ROOT=media
MEDIA_URL=/media/
